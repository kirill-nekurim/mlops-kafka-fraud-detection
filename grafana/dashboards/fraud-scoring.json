{
  "uid": "fraud-scoring",
  "title": "01 Скоринг и бизнес-показатели",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "fraud",
    "homework-monitoring"
  ],
  "editable": false,
  "description": "Живой поток Kafka → CatBoost → PostgreSQL. Панели созданы для этого проекта.",
  "panels": [
    {
      "title": "Обработка потока, TPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(scorer_transactions_total[15s])",
          "legendFormat": "Обработка потока, TPS",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Время обработки: p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scorer_processing_seconds_bucket[30s])))",
          "legendFormat": "Время обработки: p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Доля флагов фрода, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(scorer_fraud_total[30s]) / clamp_min(rate(scorer_transactions_total[30s]), 0.01)",
          "legendFormat": "Доля флагов фрода, %",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Распределение скоров во времени",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(scorer_score_bucket[30s]))",
          "legendFormat": "{{le}}",
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "unit": "short"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Секунд без успешного скоринга",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - scorer_last_success_timestamp_seconds",
          "legendFormat": "Секунд без успешного скоринга",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Загрузки модели и версия",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scorer_model_loads_total",
          "legendFormat": "{{model_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Скоры и доля фрода по версии",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_version, count(*) AS scores, round(100.0 * avg(fraud_flag),2) AS fraud_percent FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring}))\nAND ('__all' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) GROUP BY 1 ORDER BY scores DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "TPS по выбранным штату и мерчанту",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(scored_at,'5s'), count(*) / 5.0 AS tps FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring}))\nAND ('__all' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Плотность скоров: фильтры штат / мерчант",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH bins AS (\n SELECT LEAST(floor(score * 20)::int,19) AS bucket, count(*) AS n\n FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring}))\nAND ('__all' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) GROUP BY 1)\n SELECT to_char(bucket*0.05,'FM0.00') || '–' || to_char((bucket+1)*0.05,'FM0.00') AS score_range,\n n::float / sum(n) OVER () / 0.05 AS density FROM bins ORDER BY bucket",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "axisCenteredZero": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xField": "score_range",
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Доля фрода по категориям: последние 1000 операций",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH recent AS (\n SELECT * FROM scores ORDER BY created_at DESC, id DESC LIMIT 1000)\n SELECT cat_id AS category, 100.0 * avg(fraud_flag) AS fraud_percent\n FROM recent WHERE ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring}))\nAND ('__all' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) GROUP BY 1 ORDER BY fraud_percent DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "axisCenteredZero": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xField": "category",
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Сумма подозрительных операций по времени",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(scored_at,'10s'), sum(amount) FILTER (WHERE fraud_flag=1) AS flagged_amount FROM scores WHERE $__timeFilter(scored_at) AND ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring}))\nAND ('__all' IN (${merchant:sqlstring}) OR merch IN (${merchant:sqlstring})) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Ошибки скоринга и загрузки модели",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(scorer_errors_total[30s]) + rate(scorer_model_load_failures_total[30s])",
          "legendFormat": "Ошибки скоринга и загрузки модели",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "state",
        "label": "Штат",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT us_state AS __text, us_state AS __value FROM scores ORDER BY 1",
        "definition": "SELECT DISTINCT us_state AS __text, us_state AS __value FROM scores ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "'__all'",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "merchant",
        "label": "Мерчант",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT merch AS __text, merch AS __value FROM scores WHERE ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring})) ORDER BY 1",
        "definition": "SELECT DISTINCT merch AS __text, merch AS __value FROM scores WHERE ('__all' IN (${state:sqlstring}) OR us_state IN (${state:sqlstring})) ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "'__all'",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Новая модель (30 секунд)",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "scorer_model_loaded_timestamp_seconds > (time() - 30)",
        "step": "1s",
        "tagKeys": "model_version",
        "titleFormat": "Модель {{model_version}}",
        "textFormat": "Скорер загрузил {{model_version}} без перезапуска",
        "showIn": 0
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  }
}
